# Swiss Now — environment variables. Weather, water and quakes need none.
# Put web values in apps/web/.env.local (gitignored).

# OTD_API_KEY=            # opentransportdata.swiss GTFS-RT token (self-service); without it trains follow the timetable, marked stale
# RAIL_DATA_DIR=          # generated rail files; default apps/web/public/rail
# RAIL_DATA_URL=          # read rail files from a public URL (Vercel Blob) instead of RAIL_DATA_DIR
# SNAPSHOT_DIR=           # local 10-minute snapshots; default apps/web/public/snapshots
# BLOB_READ_WRITE_TOKEN=  # Vercel Blob: snapshots and rail files once deployed (also a GitHub Actions secret for gtfs.yml)
