{
  "name": "@swiss-now/story-video",
  "version": "0.0.1",
  "private": true,
  "description": "Swiss Now 'Switzerland Today' Remotion composition: renders a StorySpec over a fixed MapLibre plate. Consumed by apps/video (renders) and by the web Player on /today; the only package that imports Remotion.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@remotion/google-fonts": "4.0.522",
    "@remotion/transitions": "4.0.522",
    "@swiss-now/core": "workspace:*",
    "@swiss-now/motion": "workspace:*",
    "maplibre-gl": "^6.7.0",
    "remotion": "4.0.522",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "react": "^19.2.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
