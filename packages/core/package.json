{
  "name": "@swiss-now/core",
  "version": "0.0.1",
  "private": true,
  "description": "Swiss Now core: normalized SwissNowState contracts (zod), freshness model, source registry, and data-source adapters. Pure TypeScript \u2014 no React, no DOM.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./state": "./src/state/index.ts",
    "./sources": "./src/sources/index.ts",
    "./freshness": "./src/freshness/index.ts",
    "./geo": "./src/geo/index.ts",
    "./data-sources": "./src/data-sources/index.ts",
    "./data-sources/geoadmin": "./src/data-sources/geoadmin/index.ts",
    "./data-sources/meteoswiss/radar": "./src/data-sources/meteoswiss/radar/index.ts",
    "./data-sources/hydrology": "./src/data-sources/hydrology/index.ts",
    "./data-sources/transit": "./src/data-sources/transit/index.ts",
    "./data-sources/transit/build": "./src/data-sources/transit/build.ts",
    "./data-sources/earthquakes": "./src/data-sources/earthquakes/index.ts",
    "./snapshot": "./src/snapshot/index.ts",
    "./story": "./src/story/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-gtfs": "tsx src/cli/build-gtfs.ts",
    "build-rail-paths": "tsx src/cli/build-rail-paths.ts",
    "upload-rail": "tsx src/cli/upload-rail.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "csv-parse": "^7.0.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "h5wasm": "^0.10.3",
    "node-stream-zip": "^1.16.0",
    "pngjs": "^7.0.0",
    "proj4": "^2.22.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "@types/proj4": "^2.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
