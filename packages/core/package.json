{
  "name": "@swiss-now/core",
  "version": "0.0.1",
  "private": true,
  "description": "Swiss Now core: normalized SwissNowState contracts (zod), freshness model, source registry, and data-source adapters. Pure TypeScript \u2014 no React, no DOM.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./state": "./src/state/index.ts",
    "./sources": "./src/sources/index.ts",
    "./freshness": "./src/freshness/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
